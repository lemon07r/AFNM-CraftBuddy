{
  "name": "afnm-craftbuddy",
  "version": "7.0.0",
  "description": "Automatically calculates and displays the optimal next skill to use during crafting in Ascend From Nine Mountains",
  "author": {
    "name": "lemon07r"
  },
  "main": "dist/mod.js",
  "scripts": {
    "prebuild": "rm -rf dist/afnm-craftbuddy",
    "build": "bun run webpack --mode production",
    "postbuild": "bun scripts/zip-dist.js",
    "workshop:upload": "bun run scripts/workshop-upload.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run jest",
    "test:watch": "bun run jest --watch",
    "test:coverage": "bun run jest --coverage",
    "ui:harness:build": "mkdir -p tmp/ui-harness && cp scripts/ui/agent-browser-harness.html tmp/ui-harness/index.html && bun build scripts/ui/agent-browser-harness.tsx --outfile tmp/ui-harness/craftbuddy-ui-harness.js --target browser --format esm",
    "ui:harness:serve": "python3 -m http.server 4173 --directory tmp/ui-harness",
    "runtime:oracle": "node scripts/installed-game-runtime.js summary",
    "runtime:extract": "node scripts/installed-game-runtime.js extract",
    "runtime:grep": "node scripts/installed-game-runtime.js grep",
    "docs:check-links": "bun run scripts/docs/check-links.js",
    "docs:check-consistency": "bun run scripts/docs/check-consistency.js",
    "docs:test": "node --test scripts/docs/checks.test.js",
    "docs:check": "bun run docs:test && bun run docs:check-links && bun run docs:check-consistency",
    "optimizer:bench": "bun run scripts/optimizer/benchmark-engines.ts",
    "optimizer:bench:gate": "bun run scripts/optimizer/benchmark-engines.ts --fixed-work --json tmp/engine-benchmark-gate.json --markdown tmp/engine-benchmark-gate.md",
    "optimizer:digest": "bun run scripts/optimizer/baseline-digest.ts",
    "optimizer:parity": "bun run scripts/optimizer/run-parity-suites.ts",
    "optimizer:transition-corpus": "bun run scripts/optimizer/generate-differential-corpus.ts",
    "release:validate": "bun run typecheck && bun run test && bun run optimizer:bench:gate && bun run build && bun run docs:check"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^19.2.3",
    "afnm-types": "0.7.19",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "zip-a-folder": "^4.0.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0"
  }
}
